{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intertext.local/schema/work-manifest.schema.json",
  "title": "InterText editorial work manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "order", "sections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "order": { "type": "integer", "minimum": 1 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "order", "package"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 },
          "package": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    }
  }
}
